{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "./hooks/mlragents-hook sessionStart",
        "timeoutSec": 15
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "./hooks/mlragents-hook preToolUse",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "./hooks/mlragents-hook postToolUse",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "./hooks/mlragents-hook agentStop",
        "timeoutSec": 15
      }
    ]
  }
}
